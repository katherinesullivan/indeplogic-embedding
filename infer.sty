\newcommand*{\InferTagFormat}[1]{(#1)} %
\newcommand*{\InferTagStyle}[1]{\!\!\scalebox{.8}{#1}}
\newcommand*{\InferRefStyle}[1]{\textcolor{violet}{#1}}
\def\InferLineSkip{1mm}
\makeatletter
\newcommand{\writeLabel}[2]{%
  \IfValueT{#1}{%
    \protected@edef\@currentlabel{\InferRefStyle{#2}}%
    \label{#1}%
  }%
}
