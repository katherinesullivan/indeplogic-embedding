\newcommand{\rint}[1]{\llparenthesis\, #1 \,\rrparenthesis}
% \newcommand{\rint}[1]{\lvert #1 \rvert}
% (epsilon,delta)-lifting (Sato)
\newcommand{\dplift}[2]{\mathcal{L}_{#1}^{#2}}
\newcommand{\rimg}[2]{#1\langle #2 \rangle}
% refinement typing judgments, built on the shared turnstiles
% \judge (\vdash) and \fsem (\vDash) and the formula context \fctx.
\newcommand{\renv}{\Theta}
\newcommand{\hjudge}{\judge}
\newcommand{\hvalid}{\fsem}
\newcommand{\htj}[4]{#1 \hjudge #2 \rel #3 \rdec #4}
\newcommand{\htjd}[3]{#1 \hjudge #2 \rdec #3}
\newcommand{\rsubst}[2]{\substt{\dl{#1}}{\dl{#2}}{\dr{#1}}{\dr{#2}}}
% \cmd/\cmdtwo are normally provided by the pRHL embedding (currently
% unloaded); guard them so this section also typesets standalone.
\providecommand{\cmd}{C}
\providecommand{\cmdtwo}{D}
\newcommand{\hsub}[3]{#1 \hjudge #2 \mathrel{\le} #3}
\newcommand{\dpenv}{\fctx}
% iteration combinator (already defined in rhol.tex; guard)
\providecommand{\iter}{\op[iter]}
\newcommand{\iterM}{\op[iterM]}
% bare projection symbol pi_i, matching the symbol of the shared \prj
% (which is the applied form \prj{i}{x} = pi_i x)
\providecommand{\PRJ}[1]{\mathbf{\pi}_#1}
% same branch stated in HOL over the constructors
\newcommand{\samebr}[2]{(\exists\, t.\; #1 = \inj1{t}) \iff (\exists\, u.\; #2 = \inj1{u})}

% Rule-tag mark for \HOARE rules: every rule name in that section is prefixed
% with \hpre so it reads distinctly from the \logic rule it is discharged by.
% The actual activation/restore lives at the top/bottom of hoare2.tex so the
% prefix is confined to that section; change \hpre to change the mark.
\newcommand{\hpre}{H}


